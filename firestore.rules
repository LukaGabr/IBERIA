rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid in [
                        "FnJbRo5kMnQu9jlIykh9TmST4J52",
                        "3hR1PbPYg1dggrlbG38OsakkG8w2"
                      ];
    }
  }
}
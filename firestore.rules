rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /menu/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email in [
                        "iberiageorgian@gmail.com",
                        "lluukkaa.gabrielashvili@gmail.com"
                      ];
    }
  }
}
